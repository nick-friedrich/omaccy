#!/usr/bin/env bash

# Omaccy's intentionally quiet SketchyBar: workspaces and window context on the
# left, machine state on the right. Each plugin is a small, independently
# refreshable shell script so the bar stays useful if one command fails. Colors
# come from the shared theme palette and text from the font chosen with
# scripts/font.sh; SF Symbols glyphs keep SF Pro because they only ship there,
# falling back to plain Unicode when that font is absent (see lib/icons.sh).

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/lib/palette.sh"
source "$CONFIG_DIR/lib/aerospace.sh"
source "$CONFIG_DIR/lib/icons.sh"

FONT_FILE="$HOME/.omaccy/font"
OMACCY_FONT="inter"
if [[ -f "$FONT_FILE" ]]; then
  _omaccy_font="$(head -n 1 "$FONT_FILE" | tr -d '[:space:]')"
  case "$_omaccy_font" in
    inter|jetbrains-mono|serif) OMACCY_FONT="$_omaccy_font" ;;
  esac
fi
unset _omaccy_font
case "$OMACCY_FONT" in
  jetbrains-mono) TEXT_FONT="JetBrains Mono" ;;
  serif) TEXT_FONT="Lora" ;;
  *) TEXT_FONT="Inter" ;;
esac

STATUS_ICON_FONT="${ICON_FONT_FAMILY:-$TEXT_FONT}:Semibold:15.0"

sketchybar --bar height=34 \
  position=top \
  color="$BAR_BG" \
  border_width=0 \
  shadow=off \
  topmost=on \
  sticky=on \
  padding_left=8 \
  padding_right=8 \
  y_offset=0 \
  margin=0 \
  corner_radius=0

sketchybar --default \
  icon.color="$TEXT" \
  icon.font="$TEXT_FONT:Semibold:13.0" \
  label.color="$TEXT" \
  label.font="$TEXT_FONT:Medium:13.0" \
  background.color="$ITEM_BG" \
  background.corner_radius=7 \
  background.height=24 \
  padding_left=5 \
  padding_right=5 \
  icon.padding_left=8 \
  icon.padding_right=5 \
  label.padding_left=0 \
  label.padding_right=8

sketchybar --add event aerospace_workspace_change

sketchybar --add item native_menu left \
  --set native_menu \
    icon="" \
    icon.font.size=17 \
    label.drawing=off \
    background.drawing=off \
    click_script="$PLUGIN_DIR/menu-toggle.sh"

# Every reload (a fresh launch or `sketchybar --reload`, which a theme/font
# change now triggers) re-runs this whole script, so --add recreates these
# items from scratch and they'd otherwise default to visible. Without this,
# all 9 flash on screen for a moment before workspace_observer's own event
# below hides the empty ones. Precomputing focused/occupied here means each
# item is added already in its final state, so there's nothing to flash.
_aerospace_bin="$(find_aerospace)"
RELOAD_FOCUSED_WORKSPACE=""
RELOAD_OCCUPIED_WORKSPACES=""
if [[ -n "$_aerospace_bin" ]]; then
  RELOAD_FOCUSED_WORKSPACE="$("$_aerospace_bin" list-workspaces --focused 2>/dev/null | head -n 1)"
  RELOAD_OCCUPIED_WORKSPACES="$("$_aerospace_bin" list-windows --all --format '%{workspace}' 2>/dev/null | sort -u)"
fi
unset _aerospace_bin

for workspace in {1..9}; do
  if [[ "$workspace" == "$RELOAD_FOCUSED_WORKSPACE" ]]; then
    workspace_drawing=on
    workspace_color="$ACCENT"
  elif grep -Fxq "$workspace" <<< "$RELOAD_OCCUPIED_WORKSPACES"; then
    workspace_drawing=on
    workspace_color="$MUTED"
  else
    workspace_drawing=off
    workspace_color="$MUTED"
  fi
  sketchybar --add item "workspace.$workspace" left \
    --set "workspace.$workspace" \
      icon="$workspace" \
      icon.color="$workspace_color" \
      drawing="$workspace_drawing" \
      label.drawing=off \
      background.drawing=off \
      click_script="'$PLUGIN_DIR/workspace.sh' '$workspace'"
done
unset RELOAD_FOCUSED_WORKSPACE RELOAD_OCCUPIED_WORKSPACES workspace_drawing workspace_color

sketchybar --add item workspace_observer left \
  --set workspace_observer \
    width=0 \
    padding_left=0 \
    padding_right=0 \
    icon.drawing=off \
    label.drawing=off \
    background.drawing=off \
    update_freq=2 \
    script="$PLUGIN_DIR/workspace.sh" \
  --subscribe workspace_observer aerospace_workspace_change front_app_switched system_woke

sketchybar --add item front_app left \
  --set front_app \
    icon="◆" \
    icon.font.size=16 \
    icon.color="$ACCENT" \
    label.max_chars=34 \
    background.drawing=off \
    script="$PLUGIN_DIR/front-app.sh" \
  --subscribe front_app front_app_switched

sketchybar --add item clock right \
  --set clock \
    icon="$ICON_CLOCK" \
    icon.font="$STATUS_ICON_FONT" \
    icon.color="$TEXT" \
    update_freq=10 \
    script="$PLUGIN_DIR/clock.sh"

sketchybar --add item battery right \
  --set battery \
    icon="$ICON_BATTERY" \
    icon.font="$STATUS_ICON_FONT" \
    icon.color="$TEXT" \
    update_freq=30 \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

sketchybar --add item caffeinate right \
  --set caffeinate \
    icon="$ICON_CAFFEINATE" \
    icon.font="$STATUS_ICON_FONT" \
    icon.color="$TEXT" \
    label.drawing=off \
    update_freq=15 \
    script="$PLUGIN_DIR/caffeinate.sh" \
    click_script="$PLUGIN_DIR/caffeinate.sh click" \
    popup.align=right \
    popup.background.color="$ITEM_BG" \
    popup.background.corner_radius=7 \
    popup.background.border_width=1 \
    popup.background.border_color="$BORDER" \
  --subscribe caffeinate system_woke

sketchybar --add item caffeinate.30m popup.caffeinate \
  --set caffeinate.30m \
    icon="◷" \
    label="30 minutes" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/caffeinate.sh start 1800"

sketchybar --add item caffeinate.1h popup.caffeinate \
  --set caffeinate.1h \
    icon="◷" \
    label="1 hour" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/caffeinate.sh start 3600"

sketchybar --add item caffeinate.2h popup.caffeinate \
  --set caffeinate.2h \
    icon="◷" \
    label="2 hours" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/caffeinate.sh start 7200"

sketchybar --add item caffeinate.off popup.caffeinate \
  --set caffeinate.off \
    icon="×" \
    icon.color="$DANGER" \
    label="Turn off" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/caffeinate.sh stop"

sketchybar --add item aerospace right \
  --set aerospace \
    icon="$ICON_TILING" \
    icon.font="$STATUS_ICON_FONT" \
    icon.color="$TEXT" \
    label="Tiling" \
    update_freq=5 \
    script="$PLUGIN_DIR/aerospace-state.sh" \
    click_script="$PLUGIN_DIR/aerospace-state.sh toggle"

sketchybar --trigger aerospace_workspace_change
sketchybar --update

# Preserve the user's chosen bar across SketchyBar restarts. Hyper+M always
# remains available through AeroSpace to switch the custom bar back on.
if [[ -f "$HOME/.omaccy/native-menu-visible" ]]; then
  sketchybar --bar hidden=on
fi
