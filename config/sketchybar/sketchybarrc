#!/usr/bin/env bash

# Omaccy's intentionally quiet SketchyBar: workspaces and window context on the
# left, machine state on the right. Each plugin is a small, independently
# refreshable shell script so the bar stays useful if one command fails. Colors
# come from the shared theme palette and text from the font chosen with
# scripts/font.sh; SF Symbols glyphs keep SF Pro because they only ship there,
# falling back to plain Unicode when that font is absent (see lib/icons.sh).

CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/lib/palette.sh"
source "$CONFIG_DIR/lib/aerospace.sh"
source "$CONFIG_DIR/lib/icons.sh"

FONT_FILE="$HOME/.omaccy/font"
OMACCY_FONT="inter"
if [[ -f "$FONT_FILE" ]]; then
  _omaccy_font="$(head -n 1 "$FONT_FILE" | tr -d '[:space:]')"
  case "$_omaccy_font" in
    inter|jetbrains-mono|serif) OMACCY_FONT="$_omaccy_font" ;;
  esac
fi
unset _omaccy_font
case "$OMACCY_FONT" in
  jetbrains-mono) TEXT_FONT="JetBrains Mono" ;;
  serif) TEXT_FONT="Lora" ;;
  *) TEXT_FONT="Inter" ;;
esac

STATUS_ICON_FONT="${ICON_FONT_FAMILY:-$TEXT_FONT}:Semibold:15.0"

sketchybar --bar height=34 \
  position=top \
  color="$BAR_BG" \
  border_width=0 \
  shadow=off \
  topmost=on \
  sticky=on \
  padding_left=8 \
  padding_right=8 \
  y_offset=0 \
  margin=0 \
  corner_radius=0

sketchybar --default \
  icon.color="$TEXT" \
  icon.font="$TEXT_FONT:Semibold:13.0" \
  label.color="$TEXT" \
  label.font="$TEXT_FONT:Medium:13.0" \
  background.color="$ITEM_BG" \
  background.corner_radius=7 \
  background.height=24 \
  padding_left=5 \
  padding_right=5 \
  icon.padding_left=8 \
  icon.padding_right=5 \
  label.padding_left=0 \
  label.padding_right=8

sketchybar --add event aerospace_workspace_change

sketchybar --add item native_menu left \
  --set native_menu \
    icon="" \
    icon.font.size=17 \
    label.drawing=off \
    background.drawing=off \
    click_script="$PLUGIN_DIR/apple-menu.sh click" \
    popup.align=left \
    popup.background.color="$ITEM_BG" \
    popup.background.corner_radius=7 \
    popup.background.border_width=1 \
    popup.background.border_color="$BORDER"

# The Apple menu. Plain glyphs rather than SF Symbols, like the other popups,
# so the rows draw whether or not SF Pro is installed. An ellipsis marks the
# rows that ask before they act, as it does in the real menu.
sketchybar --add item native_menu.system_settings popup.native_menu \
  --set native_menu.system_settings \
    icon="⚙" \
    label="System Settings…" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/apple-menu.sh system-settings"

sketchybar --add item native_menu.omaccy_settings popup.native_menu \
  --set native_menu.omaccy_settings \
    icon="⇪" \
    label="Omaccy Settings…" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/apple-menu.sh omaccy-settings"

sketchybar --add item native_menu.sleep popup.native_menu \
  --set native_menu.sleep \
    icon="☾" \
    label="Sleep" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/apple-menu.sh sleep"

sketchybar --add item native_menu.restart popup.native_menu \
  --set native_menu.restart \
    icon="↻" \
    label="Restart…" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/apple-menu.sh restart"

sketchybar --add item native_menu.shutdown popup.native_menu \
  --set native_menu.shutdown \
    icon="⏻" \
    label="Shut Down…" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/apple-menu.sh shutdown"

sketchybar --add item native_menu.logout popup.native_menu \
  --set native_menu.logout \
    icon="⇥" \
    label="Log Out…" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/apple-menu.sh logout"

sketchybar --add item native_menu.hide_bar popup.native_menu \
  --set native_menu.hide_bar \
    icon="×" \
    icon.color="$MUTED" \
    label="Hide SketchyBar" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/apple-menu.sh hide-bar"

# Every reload (a fresh launch or `sketchybar --reload`, which a theme/font
# change now triggers) re-runs this whole script, so --add recreates these
# items from scratch and they'd otherwise default to visible. Without this,
# all 9 flash on screen for a moment before workspace_observer's own event
# below hides the empty ones. Precomputing focused/occupied here means each
# item is added already in its final state, so there's nothing to flash.
_aerospace_bin="$(find_aerospace)"
RELOAD_FOCUSED_WORKSPACE=""
RELOAD_OCCUPIED_WORKSPACES=""
if [[ -n "$_aerospace_bin" ]]; then
  RELOAD_FOCUSED_WORKSPACE="$("$_aerospace_bin" list-workspaces --focused 2>/dev/null | head -n 1)"
  RELOAD_OCCUPIED_WORKSPACES="$("$_aerospace_bin" list-windows --all --format '%{workspace}' 2>/dev/null | sort -u)"
fi
unset _aerospace_bin

for workspace in {1..9}; do
  if [[ "$workspace" == "$RELOAD_FOCUSED_WORKSPACE" ]]; then
    workspace_drawing=on
    workspace_color="$ACCENT"
  elif grep -Fxq "$workspace" <<< "$RELOAD_OCCUPIED_WORKSPACES"; then
    workspace_drawing=on
    workspace_color="$MUTED"
  else
    workspace_drawing=off
    workspace_color="$MUTED"
  fi
  sketchybar --add item "workspace.$workspace" left \
    --set "workspace.$workspace" \
      icon="$workspace" \
      icon.color="$workspace_color" \
      drawing="$workspace_drawing" \
      label.drawing=off \
      background.drawing=off \
      click_script="'$PLUGIN_DIR/workspace.sh' '$workspace'"
done
unset RELOAD_FOCUSED_WORKSPACE RELOAD_OCCUPIED_WORKSPACES workspace_drawing workspace_color

sketchybar --add item workspace_observer left \
  --set workspace_observer \
    width=0 \
    padding_left=0 \
    padding_right=0 \
    icon.drawing=off \
    label.drawing=off \
    background.drawing=off \
    update_freq=2 \
    script="$PLUGIN_DIR/workspace.sh" \
  --subscribe workspace_observer aerospace_workspace_change front_app_switched system_woke

sketchybar --add item front_app left \
  --set front_app \
    icon="◆" \
    icon.font.size=16 \
    icon.color="$ACCENT" \
    label.max_chars=34 \
    background.drawing=off \
    script="$PLUGIN_DIR/front-app.sh" \
    click_script="$PLUGIN_DIR/front-app.sh click" \
    popup.align=left \
    popup.background.color="$ITEM_BG" \
    popup.background.corner_radius=7 \
    popup.background.border_width=1 \
    popup.background.border_color="$BORDER" \
  --subscribe front_app front_app_switched

# The front app's menus. front-app.sh fills these in when the name is clicked,
# one row per menu, and hides the rows the app has no menu for. Sixteen is more
# than any app puts in its menu bar; keep it in step with MENU_ROWS there.
for _menu_row in {1..16}; do
  sketchybar --add item "front_app.menu.$_menu_row" popup.front_app \
    --set "front_app.menu.$_menu_row" \
      icon.drawing=off \
      label.padding_left=8 \
      drawing=off \
      background.drawing=off
done
unset _menu_row

sketchybar --add item clock right \
  --set clock \
    icon="$ICON_CLOCK" \
    icon.font="$STATUS_ICON_FONT" \
    icon.color="$TEXT" \
    update_freq=10 \
    script="$PLUGIN_DIR/clock.sh" \
    click_script="$PLUGIN_DIR/calendar.sh click" \
    popup.align=right \
    popup.background.color="$ITEM_BG" \
    popup.background.corner_radius=7 \
    popup.background.border_width=1 \
    popup.background.border_color="$BORDER"

# The calendar popup. calendar.sh fills these in when the date is clicked; the
# grid rows are monospaced because seven columns only line up when every cell
# is the same width. Six week rows is the most a month can span.
CALENDAR_FONT="JetBrains Mono:Medium:13.0"
# SketchyBar sizes a label without its leading whitespace but still draws it,
# so a week starting mid-row lost as much off its end as it had blanks at its
# front -- the first week of September stopped at the 4th. No-break spaces are
# dropped the same way. Every grid row gets the width of a full week instead:
# 28 cells of the font above, measured at about 210 points, plus slack.
CALENDAR_WIDTH=216

sketchybar --add item clock.header popup.clock \
  --set clock.header \
    icon.drawing=off \
    label.font="$TEXT_FONT:Bold:13.0" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/calendar.sh today"

sketchybar --add item clock.weekdays popup.clock \
  --set clock.weekdays \
    icon.drawing=off \
    label.font="$CALENDAR_FONT" \
    label.width="$CALENDAR_WIDTH" \
    label.color="$MUTED" \
    background.drawing=off

for _calendar_week in 1 2 3 4 5 6; do
  sketchybar --add item "clock.week$_calendar_week" popup.clock \
    --set "clock.week$_calendar_week" \
      icon.drawing=off \
      label.font="$CALENDAR_FONT" \
      label.width="$CALENDAR_WIDTH" \
      background.drawing=off
done
unset _calendar_week

sketchybar --add item clock.prev popup.clock \
  --set clock.prev \
    icon="‹" \
    label="Previous month" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/calendar.sh prev"

sketchybar --add item clock.next popup.clock \
  --set clock.next \
    icon="›" \
    label="Next month" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/calendar.sh next"

sketchybar --add item clock.open popup.clock \
  --set clock.open \
    icon="↗" \
    label="Open Calendar" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/calendar.sh open"

sketchybar --add item battery right \
  --set battery \
    icon="$ICON_BATTERY" \
    icon.font="$STATUS_ICON_FONT" \
    icon.color="$TEXT" \
    update_freq=30 \
    script="$PLUGIN_DIR/battery.sh" \
    click_script="$PLUGIN_DIR/battery.sh click" \
    popup.align=right \
    popup.background.color="$ITEM_BG" \
    popup.background.corner_radius=7 \
    popup.background.border_width=1 \
    popup.background.border_color="$BORDER" \
  --subscribe battery system_woke power_source_change

# Keep-awake is only in the bar while it is on -- caffeinate.sh draws it then
# and hides it otherwise -- and clicking it turns it off. Starting it, and the
# rest of the power settings, live in the battery popup below. Added hidden so
# a reload does not flash it on before the first tick decides.
sketchybar --add item caffeinate right \
  --set caffeinate \
    icon="$ICON_CAFFEINATE" \
    icon.font="$STATUS_ICON_FONT" \
    icon.color="$TEXT" \
    label.drawing=off \
    drawing=off \
    update_freq=15 \
    script="$PLUGIN_DIR/caffeinate.sh" \
    click_script="$PLUGIN_DIR/caffeinate.sh click" \
  --subscribe caffeinate system_woke

# The battery popup. battery.sh fills in the first two rows, and whether the
# turn-off row shows, each time it opens.
sketchybar --add item battery.status popup.battery \
  --set battery.status \
    icon.drawing=off \
    label.font="$TEXT_FONT:Bold:13.0" \
    background.drawing=off

sketchybar --add item battery.lowpower popup.battery \
  --set battery.lowpower \
    icon="◐" \
    label="Low Power Mode" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/battery.sh settings"

sketchybar --add item caffeinate.30m popup.battery \
  --set caffeinate.30m \
    icon="◷" \
    label="Keep awake for 30 minutes" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/caffeinate.sh start 1800"

sketchybar --add item caffeinate.1h popup.battery \
  --set caffeinate.1h \
    icon="◷" \
    label="Keep awake for 1 hour" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/caffeinate.sh start 3600"

sketchybar --add item caffeinate.2h popup.battery \
  --set caffeinate.2h \
    icon="◷" \
    label="Keep awake for 2 hours" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/caffeinate.sh start 7200"

sketchybar --add item caffeinate.forever popup.battery \
  --set caffeinate.forever \
    icon="∞" \
    label="Keep awake until turned off" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/caffeinate.sh start 0"

sketchybar --add item caffeinate.off popup.battery \
  --set caffeinate.off \
    icon="×" \
    icon.color="$DANGER" \
    label="Turn off keep awake" \
    drawing=off \
    background.drawing=off \
    click_script="$PLUGIN_DIR/caffeinate.sh stop"

sketchybar --add item battery.display popup.battery \
  --set battery.display \
    icon="▭" \
    label="Turn display off now" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/battery.sh display-sleep"

sketchybar --add item battery.settings popup.battery \
  --set battery.settings \
    icon="⚙" \
    label="Battery Settings…" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/battery.sh settings"

# Reports the focused workspace's layout mode, and opens a popup to change it.
# Subscribed to the workspace event so the label follows you between
# workspaces rather than waiting for the next poll; the poll stays because
# tiling can also be switched off from outside the bar.
sketchybar --add item aerospace right \
  --set aerospace \
    icon="$ICON_TILING" \
    icon.font="$STATUS_ICON_FONT" \
    icon.color="$TEXT" \
    label="Tiling" \
    update_freq=5 \
    script="$PLUGIN_DIR/aerospace-state.sh" \
    click_script="$PLUGIN_DIR/aerospace-state.sh click" \
    popup.align=right \
    popup.background.color="$ITEM_BG" \
    popup.background.corner_radius=7 \
    popup.background.border_width=1 \
    popup.background.border_color="$BORDER" \
  --subscribe aerospace aerospace_workspace_change

# One row per mode. The glyphs are plain Geometric Shapes rather than SF
# Symbols, like the caffeinate popup's, so they draw whether or not SF Pro
# made it onto the machine -- and each is a small picture of the arrangement
# it applies.
sketchybar --add item aerospace.horizontal popup.aerospace \
  --set aerospace.horizontal \
    icon="▥" \
    label="Columns" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/aerospace-state.sh set horizontal"

sketchybar --add item aerospace.vertical popup.aerospace \
  --set aerospace.vertical \
    icon="▤" \
    label="Rows" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/aerospace-state.sh set vertical"

sketchybar --add item aerospace.grid popup.aerospace \
  --set aerospace.grid \
    icon="▦" \
    label="Grid" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/aerospace-state.sh set grid"

sketchybar --add item aerospace.recursive popup.aerospace \
  --set aerospace.recursive \
    icon="◧" \
    label="Recursive" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/aerospace-state.sh set recursive"

sketchybar --add item aerospace.accordion popup.aerospace \
  --set aerospace.accordion \
    icon="▬" \
    label="Accordion" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/aerospace-state.sh set accordion"

sketchybar --add item aerospace.toggle popup.aerospace \
  --set aerospace.toggle \
    icon="×" \
    icon.color="$DANGER" \
    label="Turn tiling off" \
    background.drawing=off \
    click_script="$PLUGIN_DIR/aerospace-state.sh toggle"

sketchybar --trigger aerospace_workspace_change
sketchybar --update

# Preserve the user's chosen bar across SketchyBar restarts. Hyper+M always
# remains available through AeroSpace to switch the custom bar back on.
if [[ -f "$HOME/.omaccy/native-menu-visible" ]]; then
  sketchybar --bar hidden=on
fi
